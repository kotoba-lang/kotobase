(ns kotobase.cid-external-dag-traversal
  ;; The guest contains no commit-envelope fixture bytes. A bounded object
  ;; capability supplies a frontier key and immutable blocks; Kotoba decodes
  ;; the signed-envelope DAG-CBOR parents and owns traversal semantics.
  (:export [main check-external-parent-decode check-external-closure
            check-external-causal-height external-frontier-length
            external-envelope-length external-parent-count
            external-first-parent-length external-closure-count
            external-root-height])
  (:capabilities #{:object/get-stream}))

(defn- marker [] :string "67706172656e7473")

(defn- marker-at-loop [source :string start :i64 index :i64] :i64
  (if (= index 16)
    1
    (if (= (string-code-point-at source (+ start index))
           (string-code-point-at (marker) index))
      (marker-at-loop source start (+ index 1))
      0)))

(defn- find-marker [source :string index :i64] :i64
  (if (> (+ index 16) (string-length source))
    -1
    (if (= (marker-at-loop source index 0) 1)
      index
      (find-marker source (+ index 2)))))

(defn- hex-digit [value :i64] :i64
  (if (and (>= value 48) (<= value 57))
    (- value 48)
    (if (and (>= value 97) (<= value 102))
      (+ 10 (- value 97))
      -1)))

(defn- hex-byte [source :string offset :i64] :i64
  (let [high (hex-digit (string-code-point-at source offset))
        low (hex-digit (string-code-point-at source (+ offset 1)))]
    (if (or (< high 0) (< low 0)) -1 (+ (* high 16) low))))

(defn- parents-offset [source :string] :i64
  (let [at (find-marker source 0)]
    (if (< at 0) -1 (+ at 16))))

(defn- parent-count [source :string] :i64
  (let [offset (parents-offset source)]
    (if (< offset 0)
      -1
      (let [head (hex-byte source offset)]
        (if (and (>= head 128) (<= head 151)) (- head 128) -1)))))

(defn- parent-at-loop
  [source :string offset :i64 index :i64 target :i64]
  :string
  (if (= index target)
    (let [head (hex-byte source offset)]
      (if (and (>= head 120) (<= head 123))
        (let [length-size (- head 119)
              length (if (= length-size 1) (hex-byte source (+ offset 2)) -1)]
          (if (< length 0)
            ""
            (string-substring source offset
                              (+ offset (* 2 (+ 1 length-size length))))))
        ""))
    (let [head (hex-byte source offset)
          length-size (if (and (>= head 120) (<= head 123)) (- head 119) -1)
          length (if (= length-size 1) (hex-byte source (+ offset 2)) -1)]
      (if (or (< length-size 0) (< length 0))
        ""
        (parent-at-loop source (+ offset (* 2 (+ 1 length-size length)))
                        (+ index 1) target)))))

(defn- parent-at [source :string target :i64] :string
  (let [offset (parents-offset source)
        count (parent-count source)]
    (if (or (< offset 0) (< target 0))
      ""
      (if (>= target count)
        ""
        (parent-at-loop source (+ offset 2) 0 target)))))

(defn- decimal-loop [text :string index :i64 value :i64] :i64
  (if (= index (string-length text))
    value
    (let [digit (- (string-code-point-at text index) 48)]
      (if (or (< digit 0) (> digit 9))
        -1
        (decimal-loop text (+ index 1) (+ (* value 10) digit))))))

(defn- parent-count-at [source :string offset :i64] :i64
  (let [head (hex-byte source offset)]
    (if (and (>= head 128) (<= head 151)) (- head 128) -1)))

(defn- hinted-parents-offset [key :string envelope :string] :i64
  (let [hint (typed-cap-call :object/get-stream :string :string
                             (string-concat "offset:" key))
        offset (decimal-loop hint 0 0)]
    (if (< offset 0)
      -1
      (if (= (marker-at-loop envelope offset 0) 1) (+ offset 16) -1))))

(defn- parent-at-offset
  [source :string offset :i64 count :i64 target :i64]
  :string
  (if (or (< offset 0) (< target 0))
    ""
    (if (>= target count)
      ""
      (parent-at-loop source (+ offset 2) 0 target))))

(defn- fetch [key :string] :string
  (typed-cap-call :object/get-stream :string :string key))

(defn- fetch-envelope [key :string] :string
  (fetch (string-concat "block:" key)))

(defn- closure-node [key :string seen :string-index] :string-index
  (if (string-index-contains seen key)
    seen
    (let [next (string-index-assoc seen key 1)
          envelope (fetch-envelope key)
          offset (hinted-parents-offset key envelope)
          count (if (< offset 0) -1 (parent-count-at envelope offset))]
      (if (< count 0)
        ;; An invalid provider hint or envelope must not contribute a node.
        (string-index-new)
        (closure-parents envelope offset count 0 next)))))

(defn- closure-parents
  [envelope :string offset :i64 count :i64 index :i64
   seen :string-index]
  :string-index
  (if (= index count)
    seen
    (let [parent (parent-at-offset envelope offset count index)
          expanded (closure-node parent seen)]
      (closure-parents envelope offset count (+ index 1) expanded))))

(defn- height-node [key :string heights :string-index] :string-index
  (if (string-index-contains heights key)
    heights
    (let [visiting (string-index-assoc heights key -1)
          envelope (fetch-envelope key)
          offset (hinted-parents-offset key envelope)
          count (if (< offset 0) -1 (parent-count-at envelope offset))]
      (if (< count 0)
        (string-index-assoc visiting key -2)
        (let [expanded (height-parents envelope offset count 0 visiting)
              parent-height (max-parent-height envelope offset 0 expanded -1)]
          (if (< parent-height -1)
            (string-index-assoc expanded key -2)
            (string-index-assoc expanded key (+ parent-height 1))))))))

(defn- height-parents
  [envelope :string offset :i64 count :i64 index :i64
   heights :string-index]
  :string-index
  (if (= index count)
    heights
    (let [parent (parent-at-offset envelope offset count index)
          expanded (height-node parent heights)]
      (height-parents envelope offset count (+ index 1) expanded))))

(defn- max-parent-height
  [envelope :string offset :i64 index :i64 heights :string-index maximum :i64]
  :i64
  (if (= index (parent-count-at envelope offset))
    maximum
    (let [parent (parent-at-offset envelope offset
                                   (parent-count-at envelope offset) index)
          value (option-value-of [:option :i64]
                                 (string-index-get heights parent) -2)]
      (if (< value 0)
        -2
        (max-parent-height envelope offset (+ index 1) heights
                           (if (> value maximum) value maximum))))))

(defn- frontier [] :string (fetch "frontier"))

(defn external-frontier-length [] :i64 (string-length (frontier)))
(defn external-envelope-length [] :i64 (string-length (fetch-envelope (frontier))))
(defn external-parent-count [] :i64 (parent-count (fetch-envelope (frontier))))
(defn external-first-parent-length [] :i64
  (string-length (parent-at (fetch-envelope (frontier)) 0)))

(defn check-external-parent-decode [] :i64
  (if (= (parent-count (fetch-envelope (frontier))) 2) 1 0))

(defn external-closure-count [] :i64
  (string-index-count (closure-node (frontier) (string-index-new))))

(defn external-root-height [] :i64
  (let [root (frontier)
        heights (height-node root (string-index-new))]
    (option-value-of [:option :i64] (string-index-get heights root) -2)))

(defn check-external-closure [] :i64
  (if (= (external-closure-count) 8) 1 0))

(defn check-external-causal-height [] :i64
  (if (= (external-root-height) 4) 1 0))

(defn main [] :i64 (check-external-closure))
