{
  "name": "kotobase-capability-bench",
  "private": true,
  "description": "Capability + performance comparison of OrbitDB-, Ceramic-, ActorDB- and Holochain-shaped backends against kotobase's own Prolly/commit-DAG shape.",
  "scripts": {
    "setup": "nbb setup.cljs",
    "bench": "nbb --classpath \"$(nbb setup.cljs --print-classpath)\" run.cljs",
    "bench:semantic": "nbb --classpath \"$(nbb setup.cljs --print-classpath)\" run-semantic.cljs",
    "bench:storage": "nbb --classpath \"$(nbb setup.cljs --print-classpath)\" run-storage.cljs",
    "verify": "nbb --classpath \"$(nbb setup.cljs --print-classpath)\" verify.cljs",
    "bench:descent": "nbb --classpath \"$(nbb setup.cljs --print-classpath)\" run-descent.cljs",
    "bench:lake-chunk": "nbb --classpath \"$(nbb setup.cljs --print-classpath)\" run-lake-chunk.cljs"
  },
  "dependencies": {},
  "devDependencies": {
    "nbb": "^1.4.208"
  }
}
